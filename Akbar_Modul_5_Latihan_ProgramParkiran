    "x = set([0, 2, 4, 6])\n",
    "y = set([1, 3, 5, 6])\n",
    "\n",
    "union = x | y #Gabungkan set x dan y\n",
    "difference = x - y #Catat data yang ada di x, tapi gak ada di y\n",
    "intersection = x & y #Hanya untuk data yang sama\n",
    "symetrical_difference = x ^ y #Mengeluarkan nilai yang sama dalam kedua set\n",
    "\n",
    "print(x,'\\n', y)\n",
    "\n",
    "print('hasil union', union)\n",
    "print('hasil difference', difference)\n",
    "print('hasil intersection', intersection)\n",
    "print('hasil symetrical_difference', symetrical_difference)"
   ]
