Program lampu berdasarkan nilai cahaya sekitar:
import random
hari = 1
while True:
  mendung = [500,1000,700,1500,2000]
  Random = random.randint(0,4)
  tingdung = mendung[Random]
  LuLam = 2
  tolux = random.randint(100,25000)
  Intensitas = tolux/LuLam - tingdung
  
  print('Hari ke-', hari)
  print("intensitas cahaya = ",Intensitas)
  if Intensitas >= 10000:
    print('sekarang sedang cerah\nLampu = Mati')
  elif Intensitas < 10000 and Intensitas > 800:
    print('Agak gelap sekarang, tapi gpp\nLampu = Mati')
  elif Intensitas < 800:
    print('Gelap nyoo\nLampu = Nyala')
  IN = (input('Mau cek lagi?'))
  hari += 1
  if IN == 'tidak':
    break


